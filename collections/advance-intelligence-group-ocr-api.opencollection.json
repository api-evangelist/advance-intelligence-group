{
  "opencollection": "1.0.0",
  "info": {
    "name": "ADVANCE.AI Open Authentication OCR API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ACCESS-TOKEN",
      "value": "{{X-ACCESS-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "OCR",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OCR an identity document (all fields)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.advance.ai/openapi/face-recognition/v3/ocr-ktp-check",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Extract structured fields from a photo of an identity card via OCR. Maximum image size 15 MB."
        }
      ]
    }
  ],
  "bundled": true
}