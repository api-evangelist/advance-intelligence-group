            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseEffectiveSeconds\": \"<integer>\",\n  \"applicationId\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
